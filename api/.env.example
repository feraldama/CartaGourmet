# Configuración del backend CartaGourmet
# Copiar este archivo a `.env` y completar los valores reales.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cartagourmet
DB_PORT=5432

# --- Servidor ---
PORT=3025

# --- Seguridad ---
# Secreto para firmar los JWT. Usar una cadena larga y aleatoria en producción.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# --- CORS ---
# Orígenes permitidos, separados por coma. Usar "*" solo en una LAN cerrada.
# Ej: http://localhost:3026,http://192.168.0.17:3026
ALLOWED_ORIGINS=http://localhost:3026

# --- Libro de ventas RG 90 (opcional; ver api/config/rg90.js) ---
# Establecimiento y punto de expedición del número de comprobante ###-###-#######.
# RG90_ESTABLECIMIENTO=001
# RG90_PUNTO=001
# Tasa de IVA asumida cuando los productos no tienen ProductoIVA cargado (10, 5 o 0).
# RG90_IVA_DEFECTO=10
# A qué obligaciones imputan los comprobantes (S/N).
# RG90_IMPUTA_IVA=S
# RG90_IMPUTA_IRE=N
# RG90_IMPUTA_IRP=N
