# Configuración del backend CartaGourmet
# Copiar este archivo a `.env` y completar los valores reales.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cartagourmet
DB_PORT=5432

# --- Servidor ---
PORT=3025

# --- Seguridad ---
# Secreto para firmar los JWT. Usar una cadena larga y aleatoria en producción.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# --- CORS ---
# Orígenes permitidos, separados por coma. Usar "*" solo en una LAN cerrada.
# Ej: http://localhost:3026,http://192.168.0.17:3026
ALLOWED_ORIGINS=http://localhost:3026
